# CURIOSITY ENGINE: variables (SIN valores reales). En producción van en GitHub → Settings → Secrets, nunca aquí.
CLAUDE_CODE_OAUTH_TOKEN=     # claude setup-token (suscripción; solo job "produce")
IG_ACCESS_TOKEN=             # Instagram API con Instagram Login, token de larga duración (solo job "publish")
IG_USER_ID=                  # id de la cuenta profesional de Instagram de P&Q
IG_API_VERSION=v24.0
TIKTOK_ACCESS_TOKEN=         # Content Posting API (24 h; se renueva solo con el refresh token)
TIKTOK_REFRESH_TOKEN=        # 365 d; lo escribe pipeline/tiktok-auth.mjs
TIKTOK_CLIENT_KEY=           # app de TikTok (sandbox o producción)
TIKTOK_CLIENT_SECRET=
# Huella de los ids en el registro de CONNECT (data/ es público): 32+ caracteres aleatorios
CONNECT_HMAC_KEY=
OPENAI_API_KEY=              # desactivado: presupuesto 0 €
CE_PYTHON=python             # python con voxcpm + faster-whisper (local: pq-rrss/.venv-voxcpm/Scripts/python)
CE_GL=                       # angle (Windows) | swangle (Linux sin GPU)
CE_BROWSER=                  # Chromium para Remotion (vacío = el que descarga Remotion)
CE_STOP=                     # 1 = parada de emergencia
